generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Post {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  body       String
  imageUrl   String?
  published  Boolean   @default(false)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  comments   Comment[]
  likes      Like[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  author    String
  body      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id          String   @id @default(cuid())
  fingerprint String
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([fingerprint, postId])
}
